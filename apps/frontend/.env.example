# Frontend env — Module 7E
# Copy to apps/frontend/.env.local for local overrides.

# Backend API base URL (no trailing slash)
# Docker Compose: http://127.0.0.1:8000  (ChromaDB is on 8001)
# Local uvicorn (run.bat): http://127.0.0.1:8001
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Production example:
# NEXT_PUBLIC_API_URL=https://YOUR_API.onrender.com
