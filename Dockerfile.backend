# Production Dockerfile for Render — Module 7F (build context = repo root)
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY apps/backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY apps/backend /app/apps/backend
COPY ml /app/ml
COPY data /app/data
COPY scripts /app/scripts

RUN mkdir -p /app/uploads/heatmaps /app/uploads/clips \
    && sed -i 's/\r$//' /app/apps/backend/start.sh \
    && chmod +x /app/apps/backend/start.sh

ENV PYTHONPATH=/app:/app/apps/backend
ENV PYTHONUNBUFFERED=1
ENV ENVIRONMENT=production
ENV UPLOAD_DIR=/app/uploads

WORKDIR /app/apps/backend
EXPOSE 8000

# Render injects $PORT; start.sh defaults to 8000 locally
CMD ["./start.sh"]
