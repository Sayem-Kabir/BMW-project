# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bmwai:bmwai_secret@localhost:5432/bmwai_db
DATABASE_URL_SYNC=postgresql://bmwai:bmwai_secret@localhost:5432/bmwai_db

# ── Redis / Celery ────────────────────────────
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Security ──────────────────────────────────
SECRET_KEY=change-this-to-a-real-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
# Set true (or ENVIRONMENT=production) to require JWT on write/ack endpoints
REQUIRE_AUTH_WRITES=false
# Comma-separated extra browser origins (Vercel URL in prod)
CORS_ORIGINS=
PUBLIC_API_URL=http://127.0.0.1:8001
FRONTEND_URL=http://localhost:3000

# Spec Phase 8F — Google OAuth (optional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Spec Phase 10 — observability / hardening
SENTRY_DSN=
LOG_JSON=true
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SEC=60
MAX_UPLOAD_BYTES=5242880

# ── Frontend (apps/frontend) ──────────────────
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
# NEXT_PUBLIC_CDN_BASE_URL=
# NEXT_PUBLIC_MINIO_PUBLIC_URL=http://localhost:9000

# ── Demo runner (optional) ────────────────────
# DEMO_API_URL=http://127.0.0.1:8000
# DEMO_VIDEO_PATH=

# ── LLM APIs (optional — Ollama works without these) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Storage ───────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_EVENTS=safety-events
MINIO_BUCKET_HEATMAPS=xai-heatmaps

# ── ChromaDB ──────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── Kuksa ─────────────────────────────────────
KUKSA_HOST=localhost
KUKSA_PORT=55555

# ── MLflow ────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Spec Phase 12 — notifications (optional; console fallback when unset) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@bmwai.dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFY_CRITICAL_EMAIL_FALLBACK=

# Spec Phase 13 — performance
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
WS_MAX_HZ=4
TELEMETRY_BATCH_ENABLED=true
TELEMETRY_BATCH_FLUSH_SEC=2
ANALYTICS_CACHE_MAX_AGE_SEC=30
ASSISTANT_SEMANTIC_CACHE_TTL_SEC=300
ASSISTANT_SEMANTIC_CACHE_THRESHOLD=0.92
CDN_BASE_URL=
MINIO_PUBLIC_BASE=http://localhost:9000
KAFKA_BOOTSTRAP=localhost:19092
KAFKA_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=http://localhost:3000/admin/dashboard?billing=success
STRIPE_CANCEL_URL=http://localhost:3000/admin/dashboard?billing=cancel
DATABASE_URL_READ=
WEIGHT_SIGNING_SECRET=
REQUIRE_MODEL_SIGNATURES=false
TENANT_RATE_LIMIT=120
TENANT_RATE_WINDOW_SEC=60


# ── Phase 1 ML assets (optional overrides; defaults live in ml/driver_monitoring/config.py)
DLIB_LANDMARK_PATH=
YOLO_DRIVER_MODEL_PATH=
ML_MODELS_DIR=

# ── ML device (optional). Examples: cuda:0 | cpu | 0
# Leave empty to auto-detect (nvidia-smi / PyTorch CUDA → else CPU).
ML_DEVICE=

# ── Phase 2 road understanding (optional overrides)
SEG_ROAD_MODEL_PATH=
YOLO_ROAD_MODEL_PATH=
PEDESTRIAN_TEMPORAL_MODEL_PATH=
# MiDaS_small | DPT_Hybrid | DPT_Large — leave empty for MiDaS_small default
MIDAS_MODEL_TYPE=
# Metric conversion only applies after you calibrate these for the camera.
DEPTH_METERS_SCALE=
DEPTH_METERS_OFFSET=
