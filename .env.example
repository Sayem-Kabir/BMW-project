# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bmwai:bmwai_secret@localhost:5432/bmwai_db
DATABASE_URL_SYNC=postgresql://bmwai:bmwai_secret@localhost:5432/bmwai_db

# ── Redis / Celery ────────────────────────────
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Security ──────────────────────────────────
SECRET_KEY=change-this-to-a-real-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development

# ── LLM APIs (optional — Ollama works without these) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Storage ───────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_EVENTS=safety-events
MINIO_BUCKET_HEATMAPS=xai-heatmaps

# ── ChromaDB ──────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── Kuksa ─────────────────────────────────────
KUKSA_HOST=localhost
KUKSA_PORT=55555

# ── MLflow ────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Phase 1 ML assets (optional overrides; defaults live in ml/driver_monitoring/config.py)
DLIB_LANDMARK_PATH=
YOLO_DRIVER_MODEL_PATH=
ML_MODELS_DIR=

# ── ML device (optional). Examples: cuda:0 | cpu | 0
# Leave empty to auto-detect (nvidia-smi / PyTorch CUDA → else CPU).
ML_DEVICE=

# ── Phase 2 road understanding (optional overrides)
SEG_ROAD_MODEL_PATH=
YOLO_ROAD_MODEL_PATH=
PEDESTRIAN_TEMPORAL_MODEL_PATH=
# MiDaS_small | DPT_Hybrid | DPT_Large — leave empty for MiDaS_small default
MIDAS_MODEL_TYPE=
# Metric conversion only applies after you calibrate these for the camera.
DEPTH_METERS_SCALE=
DEPTH_METERS_OFFSET=
